{
  "name": "streamspeed",
  "description": "Easily measure the speed of your streams.",
  "keywords": [
    "stream",
    "speed"
  ],
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/node-streamspeed.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit",
    "test:unit": "mocha --require ts-node/register test/*-test.ts"
  },
  "directories": {
    "lib": "./lib"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.1.2",
    "@types/sinon": "^22.0.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=10"
  },
  "license": "MIT"
}
